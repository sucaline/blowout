{
  "name": "blowout",
  "productName": "BLOWOUT",
  "version": "1.0.0",
  "description": "Bass boost and loud the hell out of any song, live.",
  "main": "main.js",
  "license": "GPL-3.0-or-later",
  "private": true,
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "start": "electron .",
    "selftest": "electron . --selftest",
    "build": "electron-packager . BLOWOUT --platform=win32 --arch=x64 --out=dist --overwrite --icon=icon.ico --download.mirrorOptions.mirror=https://github.com/castlabs/electron-releases/releases/download/ --ignore=\"^/(dist|docs|selftest|\\.claude)\""
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "github:castlabs/electron-releases#v45.2.1+wvcus"
  }
}
