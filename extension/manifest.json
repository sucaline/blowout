{
  "manifest_version": 3,
  "name": "BLOWOUT: Bass Boost and Loud",
  "version": "1.3.0",
  "description": "Bass boost and loud-ify YouTube Music, YouTube and Spotify as they play, with an on-page panel. Optionally links to the BLOWOUT desktop app.",
  "icons": {
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_title": "BLOWOUT Link",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "sw.js"
  },
  "host_permissions": [
    "https://music.youtube.com/*",
    "https://www.youtube.com/*",
    "https://open.spotify.com/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*",
        "https://www.youtube.com/*",
        "https://open.spotify.com/*"
      ],
      "js": [
        "page.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://music.youtube.com/*",
        "https://www.youtube.com/*",
        "https://open.spotify.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
